{
  "name": "tropa-workouts",
  "private": true,
  "scripts": {
    "build": "tsc && vite build && node scripts/prepare-offline.mjs",
    "build:check": "vite build --outDir .build-check && node scripts/prepare-offline.mjs .build-check",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noUnusedLocals --noUnusedParameters",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "format": "prettier --write src scripts .storybook index.html package.json tsconfig.json vite.config.ts eslint.config.mjs stylelint.config.mjs .prettierrc.json",
    "format:check": "prettier --check src scripts .storybook index.html package.json tsconfig.json vite.config.ts eslint.config.mjs stylelint.config.mjs .prettierrc.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "storybook": "^10.6.7",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.2"
    }
  }
}
